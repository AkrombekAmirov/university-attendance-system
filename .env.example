# Database Configuration
POSTGRES_DB=turnikedb
POSTGRES_USER=turnikeuser
POSTGRES_PASSWORD=StrongSecurePass123!

# Application Configuration
APP_ENV=production
DEBUG=false
APP_NAME=University Attendance System

# Backend Configuration
DATABASE_URL=postgresql+asyncpg://turnikeuser:StrongSecurePass123!@localhost:5432/turnikedb
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
CORS_ALLOW_ORIGINS=["http://localhost:3000", "https://davomat.uznpu.uz"]
ALLOWED_HOSTS=["localhost", "127.0.0.1", "davomat.uznpu.uz", "api.davomat.uznpu.uz"]

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Worker Configuration
NUM_WORKERS=4

# Security
SECRET_KEY=your-super-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Request Limits
MAX_BODY_BYTES=10485760
REQUEST_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO
